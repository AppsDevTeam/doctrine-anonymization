{
  "name": "adt/doctrine-anonymization",
  "description": "Marks personal data on Doctrine entities and generates anonymized read-only database views from them",
  "type": "library",
  "license": "MIT",
  "keywords": ["doctrine", "anonymization", "gdpr", "views", "reporting"],
  "authors": [
    {
      "name": "Apps Dev Team",
      "email": "hello@appsdevteam.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1",
    "doctrine/dbal": "^3.6 || ^4.0",
    "doctrine/orm": "^2.14 || ^3.0",
    "symfony/console": "^6.0 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "codeception/codeception": "^5.0",
    "codeception/module-asserts": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "ADT\\DoctrineAnonymization\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  }
}
